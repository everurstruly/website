---
import { navMenuList } from "@pages/index.astro";
---

<nav
  class="lg:hidden w-full sticky top-0 bg-white/90 dark:bg-background/80 dark:text-zinc-100 backdrop-blur-sm h-16 z-50 px-4"
>
  <div
    class="flex items-center max-w-xs mx-auto justify-between gap-x-1 min-[420px]:gap-x-4 h-full"
  >
    {
      navMenuList.map((item, index, arr) => {
        return (
          <>
            <a
              href={item.href}
              class="inline-flex items-center px-1 underline-offset-2 lowercase"
            >
              <span class=":text-sm font-semibold">{item.title}</span>
            </a>
            {index < arr.length - 1 && <span class="text-xs font-sans">||</span>}
          </>
        );
      })
    }
  </div>
</nav>
