---
import { ExternalLink } from "lucide-astro";

const highlights = [
  {
    cover: "/highlights/project-cinema.jpg",
    id: "theme-editor",
    date: "2025",
    title: "Theme Visual & Code Editor",
    description:
      "A design system editor for Google's Material UI focused on building, testing, and maintaining consistent themes at scale.",
    tech: ["Material Design", "MUI", "React", "TypeScript", "Vite"],
    tags: ["Front End", "UI/UX", "Open Source", "Tooling"],
    demoUrl: "https://mui-theme-builder.netlify.app/editor",
    detailsUrl: "https://github.com/everurstruly/mui-theme-builder",
  },
  {
    cover: "/highlights/project-champions.png",
    id: "tournament",
    date: "2026",
    title: "Sport Events Nework & Workspace",
    description: "Engagement and coordination platform for tournaments operations.",
    tech: ["React.js", "Nest.js", "Next.js", "TailwindCSS", "Vite"],
    tags: ["Full Stack", "Mobile", "PWA"],
    demoUrl: "https://renna.netlify.app",
    // detailsUrl: "https://github.com/everurstruly/tournament-management-system",
  },
  {
    cover: "/highlights/project-edutech.jpg",
    id: "cleanup-extension",
    date: "2026",
    title: "AI Conversation Clarity",
    description:
      "A browser extension to surface and remove your low value AI chats from history.",
    tech: ["Typescript", "Next.js", "Tailwind CSS"],
    tags: ["Front End", "AI", "Automation", "Chrome Extension", "Tooling"],
    demoUrl: "https://chat-clarity.vercel.app",
    detailsUrl: "https://github.com/everurstruly/chat-clarity",
  },
  {
    cover: "/highlights/project-camera.jpg",
    id: "social-network",
    date: "2026",
    title: "Music Festival Discovery & Network",
    description: "Global music festival discovery and social networking platform.",
    tech: ["Next.js", "Firebase", "Tailwind", "CMS", "Automation"],
    tags: ["Full Stack", "Firebase", "Custom CMS"],
    demoUrl: "https://plur-network.com",
  },
];

const tints = ["blue", "green", "red", "yellow", "beige"];
---

<section id="highlights" class="py-20">
  <header
    class="mb-8 lg:mb-10 flex flex-wrap items-center gap-y-2 gap-x-4 justify-between"
  >
    <h2 class="text-4xl font-semibold uppercase text-zinc-800 dark:text-zinc-100">
      Featured Projects
    </h2>

    <a
      href="https://github.com/everurstruly?tab=repositories"
      class="px-0 flex gap-x-1 mt-4 text-sm sm:ms-auto hover:underline underline-offset-2 text-blue-600"
      target="_blank"
      rel="noopener noreferrer"
    >
      View Archive
      <ExternalLink class="size-4 stroke-current" />
    </a>
  </header>

  <div class="flex flex-wrap gap-y-20 gap-x-8 lg:gap-x-12 lg:gap-y-20">
    {
      highlights.map((project, idx) => {
        return (
          <article class="w-full lg:w-1/3 grow">
            <div class="h-64 w-full overflow-hidden">
              <div class="tinted-image size-full bg-zinc-100">
                <img
                  src={
                    project.cover ? project.cover : `/me/headshot-professional.jpg`
                  }
                  alt={`${project.title}`}
                  class="w-full h-full object-scale-down"
                />

                <div
                  class="tint-overlay"
                  aria-hidden="true"
                  style={`--tint: ${tints[idx % tints.length]}`}
                />
              </div>
            </div>

            <div class="flex flex-col p-1">
              <div class="flex items-start gap-x-6 justify-between py-2">
                <h4 class="text-base sm:text-lg font-semibold !leading-tight">
                  {project.title}
                </h4>
                <span class="text-sm">{project.date}</span>
              </div>

              <p class="text-sm sm:text-base text-zinc-900 dark:text-zinc-400">
                {project.description} <span class="font-semibold">Build:</span>{" "}
                {project.tech.map((tag, index, arr) => {
                  const prefix = index === 0 ? "" : ", ";
                  const sufix = index === arr.length - 1 ? "." : "";

                  return (
                    <>
                      {prefix}
                      {tag}
                      {sufix}
                    </>
                  );
                })}
              </p>

              <div class="flex items-center flex-wrap gap-x-4 gap-y-2 pt-2">
                {project.demoUrl && (
                  <a
                    href={project.demoUrl}
                    class="text-sm text-blue-600 hover:underline"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Live Demo
                  </a>
                )}{" "}
                {project.detailsUrl && project.demoUrl && (
                  <span class="text-xs">//</span>
                )}
                {project.detailsUrl && (
                  <a
                    href={project.detailsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-blue-600 hover:underline"
                  >
                    Technical Details
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .tinted-image {
    position: relative;
    transition: transform 3000ms ease;
  }

  .tinted-image .tint-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--tint, red);
    mix-blend-mode: multiply; /* tinting blend for solid colors */

    opacity: 0.65; /* base tint strength */
    transition: opacity 280ms ease;
  }

  article:hover .tint-overlay {
    opacity: 0.75;
  }

  article:hover .tinted-image {
    transform: scale(1.2);
  }
</style>
