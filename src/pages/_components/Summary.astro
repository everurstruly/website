---
import { ExternalLink, Github, Linkedin, MessageCircleMore } from "lucide-astro";
import { socialLinks } from "../seo";
import { person } from "../index.astro";
---

<section id="summary" class="pt-14 lg:pt-14 pb-8">
  <div class="max-w-fit min-[420px]:max-w-none min-[420px]:mx-auto">
    <p
      class="w-full max-w-[48ch] mx-auto text-lg sm:!leading-[1.54] min-[420px]:text-xl min-[420px]:text-center lg:text-2xl mb-5"
    >
      Hi! I'm <span class="">{person.shortName}</span>. I help improve the way
      businesses operate through technology, thoughtful design, and continuous
      improvement. Today, that means building web applications. Tomorrow, it may mean
      leading products, facilities, or business operations.
    </p>

    <div class="flex gap-x-4 sm:gap-x-6 items-center min-[420px]:justify-center">
      {
        [
          { Icon: Github, href: socialLinks.github.href },
          { Icon: Linkedin, href: socialLinks.linkedin.href },
          { Icon: MessageCircleMore, href: socialLinks.whatsapp.href },
        ].map((item) => {
          return (
            <a
              class="size-10 rounded-full border.. border-current grid place-content-center text-xs hover:border-zinc-700 text-muted-foreground dark:hover:border-zinc-400 transition-colors"
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              title={item.href.replace("https://", "").split(".")[0]}
              aria-label={`Connect with me via: ${item.href}`}
            >
              <item.Icon class="size-5 stroke-zinc-700 dark:stroke-zinc-400" />
            </a>
          );
        })
      }
    </div>

    <a
      href="https://linkedin.com/in/everurstruly"
      class="flex items-center justify-center px-0 gap-x-2 mt-8 text-base min-[420px]:mx-auto w-fit text-blue-600 mastermind_jumpscare"
    >
      Read more about me
      <ExternalLink class="size-4" />
    </a>
  </div>
</section>

<style>
  /* make anchor scrolling land below mobile topbars: 4rem on small screens, keep desktop spacing at lg */

  #summary {
    scroll-margin-top: 20rem;
  }

  @media screen and (min-width: 1024px) {
    /* desktop: respect original padding (pt-14 = 3.5rem) */
    #summary {
      /* revert to the default behaviour on desktop so we don't hardcode a size */
      scroll-margin-top: revert;
    }
  }
</style>
